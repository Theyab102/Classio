    "webpack-dev-middleware": "7.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase-tools": "15.35.0",
    "playwright-core": "1.56.1"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!marked/)"
    ]
  }
