{
  "name": "classio",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@mlc-ai/web-llm": "0.2.89",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@tiptap/core": "3.32.3",
    "@tiptap/extension-image": "^3.32.3",
    "@tiptap/extension-table": "^3.32.3",
    "@tiptap/extension-text-align": "^3.32.3",
    "@tiptap/extension-text-style": "3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/react": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "cheerio": "1.1.2",
    "dompurify": "^3.4.17",
    "firebase": "^12.10.0",
    "firebase-admin": "^14.5.0",
    "ipaddr.js": "2.2.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "mathjax-full": "^3.2.2",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "5.0.1",
    "three": "0.180.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "node scripts/build.cjs",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "check:ai": "node scripts/check-ai-config.cjs",
    "test:server": "node --test server/*.test.js",
    "test:browser": "node scripts/test-browser.cjs",
    "build:icons": "node scripts/build-icons.cjs",
    "test:presentation": "node scripts/presentation-browser.cjs",
    "test:workflows": "node scripts/workflow-browser.cjs",
    "test:notes": "node scripts/notes-browser.cjs",
    "test:polish": "node scripts/polish-browser.cjs",
    "test:sessions": "node scripts/session-browser.cjs",
    "test:podcast": "node scripts/podcast-inline-browser.cjs",
    "test:tablet": "node scripts/tablet-input-browser.cjs",
    "check:security": "node scripts/security-check.cjs all",
    "check:secrets": "node scripts/security-check.cjs source",
    "check:staged": "node scripts/security-check.cjs staged",
    "test:ai-upgrade": "node scripts/ai-upgrade-browser.cjs",
    "check:security-canaries": "node scripts/security-canaries.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "shell-quote": "^1.8.5",
    "websocket-driver": "^0.7.5",
    "@grpc/grpc-js": "^1.14.7",
    "image-size": "^2.1.0",
    "postcss": "^8.5.33",
    "underscore": "^1.13.8",
    "serialize-javascript": "^7.1.3",
    "bfj": "^9.1.3"
  },
  "jest": {
    "moduleNameMapper": {
      "^@tiptap/core/jsx-runtime$": "<rootDir>/node_modules/@tiptap/core/dist/jsx-runtime/jsx-runtime.cjs",
      "^@tiptap/pm/(.*)$": "<rootDir>/node_modules/@tiptap/pm/dist/$1/index.cjs"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!marked/).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.4",
    "playwright": "1.62.1"
  }
}
