    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "test:rules": "firebase emulators:exec --project demo-classio --only firestore,storage \"node --test tests/firebase-rules.test.cjs\"",
    "test:browser": "node tests/browser-smoke.cjs",
    "test:ui": "node tests/calm-ui-browser.cjs",
    "test:language": "node tests/language-roundtrip.cjs",
    "test:integrated": "node tests/integrated-workspace.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "proxy": "http://127.0.0.1:3001",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
