# Public build settings. Use real, monitored addresses before going live.
REACT_APP_CLASSIO_OPERATOR=
REACT_APP_CLASSIO_CONTACT_EMAIL=
REACT_APP_CLASSIO_COPYRIGHT_EMAIL=
REACT_APP_CLASSIO_COPYRIGHT_AGENT=
REACT_APP_CLASSIO_COPYRIGHT_ADDRESS=
REACT_APP_CLASSIO_COPYRIGHT_PHONE=
# Public voice endpoint for optional WAV downloads and public video transcripts.
REACT_APP_CLASSIO_TTS_URL=https://theyab102-classio-tts.hf.space

# Vercel server only. Never prefix these with REACT_APP_.
GROQ_API_KEY=
# Existing Production alias, supported server-side (case-sensitive): Groq_Key
# Gemini alias: Gemini_Key. Prefer one name per provider to avoid stale overrides.
# Default instance quotas do not require a Firebase admin credential.
AI_QUOTA_MODE=instance
# Optional shared deployment-wide quota mode: AI_QUOTA_MODE=firestore
FIREBASE_SERVICE_ACCOUNT_JSON=
# A random secret with at least 32 characters.
AI_RATE_LIMIT_SECRET=
# Optional provider model overrides
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=

# Optional Gemini Developer API adapter. Keep disabled for the default 13+ app.
# Enable only with Google terms/authorization compatible with the app audience.
GEMINI_ENABLED=false
GEMINI_API_KEY=
# Optional override; otherwise a supported model is discovered from the API.
GEMINI_MODEL=
# Server-side preference and failover order. One quota reservation per request.
AI_PROVIDER_ORDER=groq,gemini
