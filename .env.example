# Public build settings. Never put private credentials in REACT_APP_/NEXT_PUBLIC_.
REACT_APP_CLASSIO_OPERATOR=
REACT_APP_CLASSIO_CONTACT_EMAIL=
REACT_APP_CLASSIO_COPYRIGHT_EMAIL=
REACT_APP_CLASSIO_COPYRIGHT_AGENT=
REACT_APP_CLASSIO_COPYRIGHT_ADDRESS=
REACT_APP_CLASSIO_COPYRIGHT_PHONE=
REACT_APP_CLASSIO_TTS_URL=https://theyab102-classio-tts.hf.space

# SERVER ONLY. Keep existing Vercel values. Exact spelling/capitalization matters.
Groq_Key=
Groq_Key_packup=
AI_GROQ_MODEL=
Gemini_Key=
Gemini_Key_packup=
AI_GEMINI_MODEL=
AI_GEMINI_ADVANCED_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_packup=
AI_OPENROUTER_MODEL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_TOKEN_packup=
CLOUDFLARE_ACCOUNT_ID=
# Blank means the backup token belongs to the primary account.
CLOUDFLARE_ACCOUNT_ID_packup=
AI_CLOUDFLARE_MODEL=
AI_ENABLE_OLLAMA=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_API_TOKEN=
OLLAMA_API_TOKEN_packup=
AI_ROUTING_MODE=auto
AI_ALLOW_PAID=false
AI_ENABLE_BROWSER_LOCAL=false
# Random server-only secret, at least 32 characters. No default secret.
CLASSIO_SESSION_SECRET=

# Required in Vercel production for shared, fail-closed quotas.
AI_QUOTA_MODE=firestore
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=classio-4378f
# Optional separate HMAC secret; otherwise CLASSIO_SESSION_SECRET is used.
AI_RATE_LIMIT_SECRET=
AI_USER_REQUESTS_PER_10_MIN=40
AI_APP_REQUESTS_PER_DAY=250
AI_PRIMARY_TIMEOUT_MS=12000
AI_PROVIDER_ORDER=groq,cloudflare,openrouter,ollama
# Optional server-only workload overrides. Blank uses curated catalog-backed defaults.
# Text model settings never pin the vision or transcription model.
AI_GROQ_FAST_MODEL=
AI_GROQ_STUDY_MODEL=
AI_GROQ_VISION_MODEL=
AI_GROQ_AUDIO_MODEL=
AI_CLOUDFLARE_FAST_MODEL=
AI_CLOUDFLARE_STUDY_MODEL=
AI_OPENROUTER_FAST_MODEL=
AI_OPENROUTER_STUDY_MODEL=
AI_OPENROUTER_VISION_MODEL=

# Non-secret operator attestations; leave false until an authorized adult has
# checked current provider terms for Classio's 13+ school/minor audience and
# verified free allocation/hard billing caps. They do not enable billing.
AI_GROQ_STUDENT_USE_APPROVED=false
AI_GROQ_FREE_TIER_CONFIRMED=false
AI_CLOUDFLARE_STUDENT_USE_APPROVED=false
AI_CLOUDFLARE_FREE_TIER_CONFIRMED=false
AI_OPENROUTER_STUDENT_USE_APPROVED=false
AI_OLLAMA_STUDENT_USE_APPROVED=false
AI_OLLAMA_LICENSE_APPROVED=false
AI_OLLAMA_FREE_TIER_CONFIRMED=false
# Gemini Developer API remains blocked for this student audience regardless.
GEMINI_ENABLED=false

# Compatible legacy aliases; use existing bindings, do not duplicate secrets.
GROQ_API_KEY=
GROQ_API_KEY_packup=
GROQ_API_KEY_2=
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
# Other accepted Gemini backup aliases: Gemini_Key_2, Gemini_Key2, GEMINI_API_KEY2.

# Optional image services. Commons needs no key. Backups only handle 401/403.
# Dedicated Cloudflare FLUX.1 Schnell text-to-image route. Review model/provider
# terms for this audience, license and account billing controls before enabling.
# This does not enable Gemini, sketch refinement, or paid account operation.
AI_ENABLE_IMAGE_GENERATION=false
AI_IMAGE_MODEL_APPROVED=false
REMOVE_BG_API_KEY=
REMOVE_BG_API_KEY_packup=
REMOVE_BG_FREE_TIER_CONFIRMED=false
PEXELS_API_KEY=
PEXELS_API_KEY_packup=
UNSPLASH_ACCESS_KEY=
UNSPLASH_ACCESS_KEY_packup=
GOOGLE_IMAGE_SEARCH_KEY=
GOOGLE_IMAGE_SEARCH_KEY_packup=
GOOGLE_IMAGE_SEARCH_CX=
GOOGLE_IMAGE_SEARCH_FREE_TIER_CONFIRMED=false
AVATAR_SHARING_ENABLED=false
