# Public build settings. These are not private API credentials.
REACT_APP_CLASSIO_OPERATOR=
REACT_APP_CLASSIO_CONTACT_EMAIL=
REACT_APP_CLASSIO_COPYRIGHT_EMAIL=
REACT_APP_CLASSIO_COPYRIGHT_AGENT=
REACT_APP_CLASSIO_COPYRIGHT_ADDRESS=
REACT_APP_CLASSIO_COPYRIGHT_PHONE=
REACT_APP_CLASSIO_TTS_URL=https://theyab102-classio-tts.hf.space

# Optional public Firebase web config overrides. Existing project defaults remain.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
# Required for original-file recall; use the exact bucket name from Firebase.
REACT_APP_FIREBASE_STORAGE_BUCKET=

# SERVER ONLY: configure securely in Vercel, never with REACT_APP_ prefixes.
GROQ_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Random secrets of at least 32 characters. Never commit real values.
AI_RATE_LIMIT_SECRET=
# Recommended separate signing key. Falls back to AI_RATE_LIMIT_SECRET if unset.
CLASSIO_SESSION_SECRET=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Set a currently available vision model from your Groq project's model catalog.
GROQ_VISION_MODEL=

# Gemini is opt-in: confirm the deployment's audience is permitted, the selected
# model currently has a free tier, and the Google project won't incur charges.
# No model/free-tier eligibility was verified in this restricted environment.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_ENABLED=false
GEMINI_FREE_TIER_VERIFIED=false
